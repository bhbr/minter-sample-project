{
    "compilerOptions": {
        "rootDir": "./src", // contains the TS code to be compiled
        "outDir": "./dist", // location of the exported JS files

        "target": "ES2021", // exported JS language version

        // resolve node module imports (e. g. '@bhbr/minter')
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "declaration": true, // creates .d.ts files
        "declarationMap": true, // created d.ts.map files
        "sourceMap": true, // creates .js.map files

        "esModuleInterop": true, // helps with importing CommonJS modules (if desired)
        "skipLibCheck": false, // check .d.ts files for type errors


        // APIs used in the source
        "lib": [
            "ES2021", // Array, Set, Promise, ...
            "DOM", // DOM elements, Events, ...
            "DOM.Iterable" // iterating over DOM elements
        ],
    },
    "include": [
        "src/**/*.ts" // which TS files to compile (all in all subfolders of src/)
    ]
}
